[Unit]
Description=SentinelFlow sshd journal to Kafka collector
After=network-online.target sssd.service sshd.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/sentinelflow/telemetry.env
ExecStart=/opt/sentinelflow/telemetry/venv/bin/python /opt/sentinelflow/telemetry/sshd_to_kafka.py
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/log/journal /run/log/journal

[Install]
WantedBy=multi-user.target
